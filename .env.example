# Self-hosted Countly analytics (optional).
# Analytics only loads after the visitor accepts the consent banner AND both of
# these are set. Leave them unset (e.g. in local dev) and no analytics runs.
#
# NEXT_PUBLIC_COUNTLY_URL      Base URL of your Countly server, e.g. https://countly.example.com
# NEXT_PUBLIC_COUNTLY_APP_KEY  The per-app key from the Countly dashboard (Management → Applications)
NEXT_PUBLIC_COUNTLY_URL=
NEXT_PUBLIC_COUNTLY_APP_KEY=
